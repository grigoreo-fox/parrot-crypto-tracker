{
  "name": "parrot-crypto-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy:sql",
    "copy:sql": "node -e \"require('node:fs').cpSync('src/database/migrations', 'dist/src/database/migrations', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && jest --runInBand"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "dotenv": "16.6.1",
    "express": "4.22.3"
  }
}
