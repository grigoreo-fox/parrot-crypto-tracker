{
  "name": "parrot-crypto-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy:sql && npm run copy:docs",
    "copy:sql": "node -e \"require('node:fs').cpSync('src/database/migrations', 'dist/src/database/migrations', { recursive: true })\"",
    "copy:docs": "node -e \"const fs=require('node:fs'); fs.cpSync('src/docs', 'dist/src/docs', { recursive: true }); fs.cpSync('src/ui', 'dist/src/ui', { recursive: true }); fs.copyFileSync('openapi.json', 'dist/src/openapi.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:openapi": "redocly lint openapi.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "sync:catalog": "npm run build && node dist/src/sync-catalog-cli.js",
    "test": "npm run build && jest --runInBand"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.24",
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@types/supertest": "7.2.1",
    "express-openapi-validator": "5.5.5",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "axios": "1.21.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "swagger-ui-dist": "5.34.1"
  }
}
